#!/usr/bin/env bash
#MISE description="Build the Windows localproxy on GitHub Actions and install it into bin/"
#USAGE arg "<tag>" help="Upstream release tag, e.g. v3.3.1"
set -euo pipefail

repo=$(git remote get-url origin | sed -E 's#(\.git)?$##; s#.*[:/]([^/]+/[^/]+)$#\1#')
workflow=localproxy-windows.yml
# Tasks don't get shell wrappers, so select the gh account that owns this repo
GH_TOKEN=$(gh auth token --user "${repo%%/*}" 2>/dev/null || gh auth token)
export GH_TOKEN

started=$(date -u -d '-1 minute' +%FT%TZ)
gh workflow run "$workflow" --repo "$repo" -f tag="$usage_tag"

run=""
for _ in {1..12}; do
  sleep 5
  run=$(gh run list --repo "$repo" --workflow "$workflow" --event workflow_dispatch \
    --created ">=$started" --limit 1 --json databaseId --jq '.[0].databaseId // empty')
  [ -n "$run" ] && break
done
[ -n "$run" ] || { echo "Workflow run did not appear" >&2; exit 1; }

gh run watch "$run" --repo "$repo" --exit-status

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
gh run download "$run" --repo "$repo" --name localproxy-windows-x64 --dir "$work"
install -m 755 "$work/localproxy.exe" bin/localproxy-x86_64-pc-windows-gnu.exe

# The new exe links OpenSSL statically, so the end-of-life DLLs are no longer needed
rm -f assets/libssl-1_1-x64.dll assets/libcrypto-1_1-x64.dll
echo "Installed localproxy $usage_tag for Windows"
